{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CareerOS: start web dev server",
            "type": "shell",
            "command": "npm run dev -- --host 127.0.0.1",
            "options": {
                "cwd": "${workspaceFolder}/web"
            },
            "isBackground": true,
            "problemMatcher": {
                "owner": "vite",
                "pattern": {
                    "regexp": ".*"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "Local:",
                    "endsPattern": "Local:"
                }
            }
        }
    ]
}